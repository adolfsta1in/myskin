    "When on, Velvi locks each time you leave the app and hides its content in the app switcher." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, sperrt sich Velvi jedes Mal, wenn du die App verlässt, und verbirgt den Inhalt im App-Umschalter."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando está activado, Velvi se bloquea cada vez que sales de la app y oculta su contenido en el selector de apps."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, o Velvi bloqueia toda vez que você sai do app e esconde o conteúdo no seletor de apps."
          }
        }
      }
    },
    "Where did you inject?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wo hast du gespritzt?"
