    },
    "6 questions about your joints. Psoriasis can affect joints, so it's worth checking." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "6 Fragen zu deinen Gelenken. Psoriasis kann die Gelenke betreffen, deshalb lohnt sich ein Check."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "6 preguntas sobre tus articulaciones. La psoriasis puede afectarlas, así que vale la pena revisar."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "6 perguntas sobre suas articulações. A psoríase pode afetar as articulações, então vale a pena checar."
          }
        }
      }
    },
    "6 yes/no questions about your joints. Psoriasis can affect joints, so it's worth checking now and then." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "6 Ja/Nein-Fragen zu deinen Gelenken. Psoriasis kann die Gelenke betreffen, deshalb lohnt sich ab und zu ein Check."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "6 preguntas de sí o no sobre tus articulaciones. La psoriasis puede afectarlas, así que vale la pena revisar de vez en cuando."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "6 perguntas de sim ou não sobre suas articulações. A psoríase pode afetar as articulações, então vale checar de vez em quando."
          }
        }
      }
    },
    "A 10-second note about your skin" : {
