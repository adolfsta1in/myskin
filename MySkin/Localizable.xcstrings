    "Log triggers and food on most days: links between them and your itch show up after about three weeks." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trag an den meisten Tagen Auslöser und Essen ein: Zusammenhänge mit deinem Juckreiz zeigen sich nach etwa drei Wochen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registre gatilhos e alimentação na maioria dos dias: as relações com sua coceira aparecem depois de umas três semanas."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra desencadenantes y comida la mayoría de los días: las relaciones con tu picazón aparecen tras unas tres semanas."
          }
        }
