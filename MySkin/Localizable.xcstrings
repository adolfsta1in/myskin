    "Very strong. Usually short courses; not for the face or skin folds unless your doctor says so." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sehr stark. Meist kurzzeitig; nicht für Gesicht oder Hautfalten, außer auf ärztliche Anweisung."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muito forte. Geralmente por pouco tempo; não use no rosto nem nas dobras, a menos que o médico indique."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muy fuerte. Normalmente por poco tiempo; no en la cara ni en los pliegues, salvo que tu médico lo indique."
          }
        }
      }
    },
