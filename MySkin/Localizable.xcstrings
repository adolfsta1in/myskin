          }
        }
      }
    },
    "Photos are kept inside Velvi. They are not added to your photo library and are not included in device backups." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos bleiben in Velvi. Sie werden nicht zu deiner Mediathek hinzugefügt und sind nicht in Gerätebackups enthalten."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las fotos se quedan dentro de Velvi. No se agregan a tu fototeca ni se incluyen en las copias de seguridad del dispositivo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As fotos ficam dentro do Velvi. Elas não vão para a sua fototeca e não entram nos backups do aparelho."
          }
        }
      }
    },
    "Photos never go to your shared photo library or device backups" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos landen nie in deiner geteilten Mediathek oder in Gerätebackups"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las fotos nunca van a tu fototeca compartida ni a las copias de seguridad del dispositivo"
