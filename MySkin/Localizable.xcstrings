    "6 questions about your joints. Psoriasis can affect joints, so it's worth checking." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "6 Fragen zu deinen Gelenken. Psoriasis kann die Gelenke betreffen, deshalb lohnt sich ein Check."
          }
