          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datos de diario informados por el paciente en la app Velvi. El índice de gravedad y el área son estimaciones del propio paciente, no un PASI clínico. No es un diagnóstico."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
