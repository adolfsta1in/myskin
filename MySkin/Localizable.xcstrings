    "Location is off for Velvi, so humidity and UV can't be shown." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ortungsdienste sind für Velvi aus, daher können Luftfeuchtigkeit und UV nicht angezeigt werden."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ubicación está desactivada para Velvi, así que no se pueden mostrar la humedad ni el UV."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A localização está desativada para o Velvi, então umidade e UV não podem ser mostrados."
          }
        }
      }
    },
