    "On darker skin, look for purple, grey or dark brown instead of red." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf dunklerer Haut achte auf Violett, Grau oder Dunkelbraun statt Rot."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em pele mais escura, observe tons arroxeados, acinzentados ou marrom-escuros em vez de vermelho."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En piel más oscura, busca tonos morados, grises o marrón oscuro en lugar de rojo."
          }
        }
      }
    },
    "On days with %@, itch averaged %@/10, vs %@/10 on other days (%lld times)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "On days with %1$@, itch averaged %2$@/10, vs %3$@/10 on other days (%4$lld times)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An Tagen mit %1$@ lag der Juckreiz im Schnitt bei %2$@/10, an anderen Tagen bei %3$@/10 (%4$lld-mal)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nos dias com %1$@, a coceira ficou em média em %2$@/10, contra %3$@/10 nos outros dias (%4$lld vezes)."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los días con %1$@, la picazón promedió %2$@/10, frente a %3$@/10 en otros días (%4$lld veces)."
          }
        }
      }
    },
    "On the same or next day after %@, itch averaged %@/10, vs %@/10 on other days (%lld times)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "On the same or next day after %1$@, itch averaged %2$@/10, vs %3$@/10 on other days (%4$lld times)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am selben oder nächsten Tag nach %1$@ lag der Juckreiz im Schnitt bei %2$@/10, an anderen Tagen bei %3$@/10 (%4$lld-mal)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No mesmo dia ou no dia seguinte a %1$@, a coceira ficou em média em %2$@/10, contra %3$@/10 nos outros dias (%4$lld vezes)."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El mismo día o el día siguiente a %1$@, la picazón promedió %2$@/10, frente a %3$@/10 en otros días (%4$lld veces)."
          }
        }
      }
    },
