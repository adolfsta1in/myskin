            "value" : "Seu diário continua neste iPhone · Exportar"
          }
        }
      }
    },
    "Your diary is stored in the app on this iPhone and included in your iPhone backup" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Tagebuch wird in der App auf diesem iPhone gespeichert und ist in deinem iPhone-Backup enthalten"
          }
        },
        "es-419" : {
          "stringUnit" : {
