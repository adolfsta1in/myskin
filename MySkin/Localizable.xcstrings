          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dados de diário informados pelo próprio paciente no app MySkin. O índice de gravidade e a área são estimativas do paciente, não um PASI clínico. Não é um diagnóstico."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
