          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível criar o PDF."
          }
        }
      }
    },
    "The day after %@, itch averaged %@/10, vs %@/10 on other days (%lld times)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am Tag nach %1$@ lag der Juckreiz im Schnitt bei %2$@/10, an anderen Tagen bei %3$@/10 (%4$lld-mal)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The day after %1$@, itch averaged %2$@/10, vs %3$@/10 on other days (%4$lld times)."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El día después de %1$@, la picazón promedió %2$@/10, frente a %3$@/10 en otros días (%4$lld veces)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No dia seguinte a %1$@, a coceira ficou em média em %2$@/10, contra %3$@/10 nos outros dias (%4$lld vezes)."
          }
        }
      }
    },
    "The export contains check-ins, body map assessments, treatments, doses and questionnaires. Photos aren't included." : {
