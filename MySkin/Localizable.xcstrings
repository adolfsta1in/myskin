    "That sounds tough. It's in your diary." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das klingt anstrengend. Es steht jetzt in deinem Tagebuch."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suena difícil. Ya está en tu diario."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parece difícil. Já está no seu diário."
          }
        }
      }
    },
    "That's why links are hard to spot on your own. A short daily note helps you and your doctor see patterns." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deshalb sind Zusammenhänge allein schwer zu erkennen. Eine kurze tägliche Notiz hilft dir und deinem Arzt oder deiner Ärztin, Muster zu sehen."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por eso es difícil notar las relaciones por tu cuenta. Una nota diaria breve te ayuda a ti y a tu médico a ver patrones."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por isso é difícil notar as relações sozinho. Uma anotação diária rápida ajuda você e seu médico a ver padrões."
          }
        }
      }
    },
    "The PDF couldn't be created." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das PDF konnte nicht erstellt werden."
