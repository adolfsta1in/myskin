    "Icotrokinra (Icotyde)" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icotrokinra (Icotyde)"
          }
        },
        "es-419" : {
          "stringUnit" : {
