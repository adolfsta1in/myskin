          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu diário fica salvo no app neste iPhone e entra no backup do iPhone"
          }
        }
      }
    },
    "Your diary isn't sent anywhere — you choose what to share. Weather, if you turn it on, uses your approximate location" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Tagebuch wird nirgendwohin gesendet – du entscheidest, was du teilst. Das Wetter nutzt, wenn du es einschaltest, deinen ungefähren Standort"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu diario no se envía a ninguna parte: tú eliges qué compartir. El clima, si lo activas, usa tu ubicación aproximada"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu diário não é enviado para lugar nenhum — você escolhe o que compartilhar. O tempo, se você ativar, usa sua localização aproximada"
          }
        }
      }
    },
    "Your diary starts today." : {
      "localizations" : {
