    "MySkin is a diary. It helps you notice patterns and talk to your doctor." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MySkin ist ein Tagebuch. Es hilft dir, Muster zu erkennen und mit deinem Arzt oder deiner Ärztin zu sprechen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O MySkin é um diário. Ele ajuda você a notar padrões e conversar com seu médico."
