        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As fotos nunca vão para sua fototeca compartilhada nem para backups do aparelho"
          }
        }
      }
    },
    "Photos of the same area over time make changes easier to see — for you and your doctor." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos desselben Bereichs über die Zeit machen Veränderungen sichtbarer – für dich und deinen Arzt oder deine Ärztin."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las fotos de la misma zona a lo largo del tiempo hacen más fáciles de ver los cambios, para ti y tu médico."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos da mesma área ao longo do tempo facilitam ver as mudanças — para você e seu médico."
          }
        }
