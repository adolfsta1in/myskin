        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Velvi uses your approximate location to show humidity and UV where you are. Your location isn't stored."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velvi usa tu ubicación aproximada para mostrar la humedad y el índice UV donde estás. Tu ubicación no se guarda."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Velvi usa sua localização aproximada para mostrar a umidade e o índice UV onde você está. Sua localização não é armazenada."
