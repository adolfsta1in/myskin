    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velvi nutzt deinen ungefähren Standort, um Luftfeuchtigkeit und UV-Index an deinem Ort anzuzeigen. Dein Standort wird nicht gespeichert."
